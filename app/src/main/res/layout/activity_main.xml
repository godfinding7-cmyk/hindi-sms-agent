<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- PREMIUM HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#091B3A"
            android:paddingLeft="22dp"
            android:paddingTop="28dp"
            android:paddingRight="22dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hindi SMS"
                android:textColor="#FFFFFF"
                android:textSize="31sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reminder Agent"
                android:textColor="#61A7FF"
                android:textSize="35sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Authorized • Consent Based • Smart Reminders"
                android:textColor="#D2DDF2"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="#18376B"
                    android:gravity="center"
                    android:text="Consent Only"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="#18376B"
                    android:gravity="center"
                    android:text="Fast Queue"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="#18376B"
                    android:gravity="center"
                    android:text="Direct SMS"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- CONTENT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- IDENTITY CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reminder Identity"
                    android:textColor="#101828"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="SMS में दिखने वाला नाम"
                    android:textColor="#667085"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/identityInput"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#2F6FED"
                    android:hint="Bill Reminder Service"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true"
                    android:text="Bill Reminder Service"
                    android:textColor="#101828"
                    android:textSize="17sp" />

            </LinearLayout>


            <!-- TEMPLATE CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="#FFFFFF"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMS Template"
                    android:textColor="#101828"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="हर customer के लिए अपने-आप personalize होगा"
                    android:textColor="#667085"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/templateInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#AFC8F8"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:lineSpacingExtra="4dp"
                    android:minHeight="190dp"
                    android:padding="10dp"
                    android:text="नमस्कार {name}, यह {identity} का reminder है। आपके रिकॉर्ड में ₹{amount} का बिल बाकी है, जिसकी अंतिम तारीख {due} है। Consumer No. ****{last4}. भुगतान केवल आधिकारिक वेबसाइट, ऐप या अधिकृत केंद्र से करें।"
                    android:textColor="#101828"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="{name}   {identity}   {amount}   {due}   {last4}"
                    android:textColor="#2563EB"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- CUSTOMER IMPORT -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="#FFFFFF"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer List"
                    android:textColor="#101828"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="CSV file import करके SMS queue तैयार करें"
                    android:textColor="#667085"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/importBtn"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#2563EB"
                    android:text="1. Import Customer CSV"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/listInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="#EDF4FF"
                    android:padding="15dp"
                    android:text="अभी कोई customer list import नहीं हुई है।"
                    android:textColor="#344054"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- ACTIONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="#FFFFFF"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Actions"
                    android:textColor="#101828"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="पहले SMS check करें, फिर queue शुरू करें"
                    android:textColor="#667085"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/previewBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#E6EEFF"
                    android:text="2. Preview First SMS"
                    android:textAllCaps="false"
                    android:textColor="#175CD3"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/startBtn"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#039855"
                    android:text="3. Start Auto SMS Queue"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/stopBtn"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#FEE4E2"
                    android:text="Stop Queue"
                    android:textAllCaps="false"
                    android:textColor="#B42318"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- STATUS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="#0B1F3F"
                android:elevation="7dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS &amp; PROGRESS"
                    android:textColor="#AFC6EA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Status: Ready"
                    android:textColor="#32D583"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="SMS queue activity यहाँ दिखाई देगी"
                    android:textColor="#9FB2D1"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- FOOTER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="25dp"
                android:gravity="center"
                android:text="Use responsibly • Authorized customers only"
                android:textColor="#667085"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
